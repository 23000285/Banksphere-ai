# BankSphere AI — Environment Configuration Template
# Copy to .env and fill in values. Never commit .env itself.

# ---------------------------------------------------------------------------
# LLM Provider (via LiteLLM)
# ---------------------------------------------------------------------------
# Default: mock mode — no API keys, no network, no cost.
# Switch LLM_PROVIDER to "gemini" or "bedrock" when ready (see below).
LLM_PROVIDER=mock
LLM_MODEL=mock-response
MOCK_LLM=true

# ---------------------------------------------------------------------------
# Optional: Google Gemini (free tier)
# ---------------------------------------------------------------------------
# To use Gemini, set:
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini/gemini-3.8-flash
#   MOCK_LLM=false
#   GEMINI_API_KEY=your-key-here
#
# Free-tier quotas are limited and not guaranteed. Do not rely on them for
# automated tests or CI. Obtain a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: Amazon Bedrock
# ---------------------------------------------------------------------------
# To use Bedrock, set:
#   LLM_PROVIDER=bedrock
#   LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
#   MOCK_LLM=false
#   AWS_REGION=us-east-1
#
# Bedrock incurs per-token charges. Configure AWS credentials separately.
# AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/banksphere.db

# API security (placeholder — replace before any real deployment)
API_SECRET_KEY=CHANGE_ME_BEFORE_USE
