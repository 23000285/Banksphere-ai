# BankSphere AI — Environment Configuration Template
# Copy to .env and fill in values. Never commit .env itself.

# LLM Provider (via LiteLLM)
LLM_PROVIDER=bedrock
LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
AWS_REGION=us-east-1

# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/banksphere.db

# Mock mode: set to "true" to use deterministic mock LLM responses (for tests/demo)
MOCK_LLM=false

# API security (placeholder — replace in production)
API_SECRET_KEY=CHANGE_ME_BEFORE_USE
